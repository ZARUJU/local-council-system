{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-council.example/schema/municipalities.schema.json",
  "title": "local-council-data municipalities master",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "municipalities"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "municipalities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "prefecture"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "prefecture": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
